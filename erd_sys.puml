  toast_blks_read : bigint
}

entity "sys.edb$system_waits" as sys__edb$system_waits {
  avg_wait : numeric
  dbname : name
  edb_id : bigint
  max_wait : numeric
  totalwait : numeric
  wait_count : bigint
  wait_name : text
}

entity "sys.job_run_details" as sys__job_run_details {
  runid : bigint <<PK>>
  endtime : timestamp with time zone
  error : text
  jobid : bigint
  scheduletime : timestamp with time zone
  starttime : timestamp with time zone
  status : character
  workerpid : integer
}

entity "sys.jobs" as sys__jobs {
  jobid : bigint <<PK>>
  jobcommand : text
  jobnextrun : timestamp with time zone
  jobuser : text
}

@enduml